<Page x:Class="PolestarShowroom.Paginas.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="700"
      Title="Iniciar sesión" FontFamily="{StaticResource Fuente}" Background="{StaticResource FondoBrush}"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Page.Resources>
        <Storyboard x:Key="SbEntrada">
            <DoubleAnimation Storyboard.TargetName="raiz" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="raiz"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="16" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Error: el formulario "niega con la cabeza" (0,4 s). Feedback de error inmediato. -->
        <Storyboard x:Key="SbError">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="formulario"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="-9"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="9"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="-6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.38" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SbEntrada}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid x:Name="raiz">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== PANEL DE MARCA (izquierda) ===================== -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#111317" Offset="0"/>
                    <GradientStop Color="#3A2E1F" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgLateral" Stretch="UniformToFill" Opacity="0.55"/>
            <Viewbox x:Name="siluetaLogin" VerticalAlignment="Bottom" Margin="40,0,40,40" Opacity="0.35">
                <Canvas Width="300" Height="100">
                    <Path Data="{StaticResource SiluetaCarroceria}" Fill="{StaticResource AcentoBrush}"/>
                    <Path Data="{StaticResource SiluetaVentanas}" Fill="#55000000"/>
                    <Path Data="{StaticResource SiluetaRuedas}" Fill="#0B0C0E"/>
                </Canvas>
            </Viewbox>
            <StackPanel Margin="56,56,48,0" VerticalAlignment="Top">
                <TextBlock Text="ÁREA DE CLIENTES" Foreground="{StaticResource AcentoBrush}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Todo tu Polestar, en un solo lugar." Foreground="White" FontSize="34"
                           FontWeight="Light" TextWrapping="Wrap" Margin="0,10,0,26"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Path Data="{StaticResource FormaEstrella}" Fill="{StaticResource AcentoBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    <TextBlock Text="Sigue el estado de tu pedido" Foreground="#D5D7DC" FontSize="15" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Path Data="{StaticResource FormaEstrella}" Fill="{StaticResource AcentoBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    <TextBlock Text="Reserva pruebas de conducción" Foreground="#D5D7DC" FontSize="15" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource FormaEstrella}" Fill="{StaticResource AcentoBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    <TextBlock Text="Ofertas exclusivas para clientes" Foreground="#D5D7DC" FontSize="15" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===================== FORMULARIO (derecha) ===================== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="formulario" Width="400" VerticalAlignment="Center" Margin="0,40">
                <StackPanel.RenderTransform>
                    <TranslateTransform X="0"/>
                </StackPanel.RenderTransform>

                <TextBlock Text="Iniciar sesión" Style="{StaticResource TituloSeccion}" FontSize="30"/>
                <TextBlock Text="Accede con el correo con el que te registraste en tu tienda Polestar."
                           Style="{StaticResource TextoSuave}" Margin="0,6,0,26"/>

                <!-- Mensaje de error general (credenciales incorrectas / bloqueo) -->
                <Border x:Name="avisoError" Background="{StaticResource ErrorFondoBrush}" BorderBrush="{StaticResource ErrorBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,18" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <TextBlock x:Name="txtAvisoError" Foreground="{StaticResource ErrorBrush}" FontSize="14"
                                   TextWrapping="Wrap" MaxWidth="330"/>
                    </StackPanel>
                </Border>

                <!-- Correo -->
                <TextBlock Text="Correo electrónico" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtUsuario" Style="{StaticResource CampoTexto}" TabIndex="10"
                         AutomationProperties.Name="Correo electrónico" TextChanged="Campo_Cambiado"/>
                <TextBlock x:Name="errUsuario" Foreground="{StaticResource ErrorBrush}" FontSize="13"
                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <!-- Contraseña -->
                <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}" Margin="0,18,0,6"/>
                <Grid>
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource CampoPassword}" TabIndex="11"
                                 Padding="12,10,90,10" AutomationProperties.Name="Contraseña"
                                 PasswordChanged="Password_Cambiada" KeyUp="Password_KeyUp" GotKeyboardFocus="Password_Foco"/>
                    <TextBox x:Name="txtPasswordVisible" Style="{StaticResource CampoTexto}" TabIndex="11"
                             Padding="12,10,90,10" Visibility="Collapsed" AutomationProperties.Name="Contraseña visible"
                             TextChanged="Campo_Cambiado" KeyUp="Password_KeyUp" GotKeyboardFocus="Password_Foco"/>
                    <Button x:Name="btnVerPassword" Content="Mostrar" Style="{StaticResource BotonEnlace}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" TabIndex="12"
                            Click="VerPassword_Click" ToolTip="Mostrar u ocultar la contraseña"/>
                </Grid>
                <TextBlock x:Name="errPassword" Foreground="{StaticResource ErrorBrush}" FontSize="13"
                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                <TextBlock x:Name="avisoMayus" Text="⚠ Bloq Mayús está activado" Foreground="{StaticResource AcentoTextoBrush}"
                           FontSize="13" Margin="0,6,0,0" Visibility="Collapsed"/>

                <!-- Recordarme + contraseña olvidada -->
                <Grid Margin="0,16,0,0">
                    <CheckBox x:Name="chkRecordar" Content="Recordar mi correo" FontSize="14" TabIndex="13"
                              VerticalAlignment="Center" Foreground="{StaticResource TextoBrush}"/>
                    <Button Content="¿Has olvidado tu contraseña?" Style="{StaticResource BotonEnlace}" FontSize="13"
                            HorizontalAlignment="Right" TabIndex="14" Click="Olvido_Click"/>
                </Grid>

                <!-- Entrar: IsDefault hace que la tecla Intro también envíe el formulario -->
                <Button x:Name="btnEntrar" Content="Entrar" Style="{StaticResource BotonPrimario}" IsDefault="True"
                        Margin="0,26,0,0" Padding="22,13" TabIndex="15" Click="Entrar_Click"/>

                <Separator Margin="0,26" Background="{StaticResource BordeBrush}"/>

                <TextBlock Style="{StaticResource TextoSuave}">
                    <Run Text="¿Aún no eres cliente?"/>
                    <Run Text="Pide tu cuenta en cualquier tienda Polestar al reservar una prueba."/>
                </TextBlock>

                <!-- Datos de prueba visibles para quien evalúe el prototipo -->
                <Border Background="#ECE8E1" CornerRadius="4" Padding="14,10" Margin="0,18,0,0">
                    <TextBlock FontSize="13" Foreground="{StaticResource TextoSuaveBrush}" TextWrapping="Wrap">
                        <Run Text="Usuario de prueba:" FontWeight="SemiBold"/>
                        <Run Text="cliente@polestar.es  ·  contraseña: Polestar26"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
