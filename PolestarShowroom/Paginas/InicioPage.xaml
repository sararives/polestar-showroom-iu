<Page x:Class="PolestarShowroom.Paginas.InicioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="1400"
      Title="Inicio" FontFamily="{StaticResource Fuente}" Background="{StaticResource FondoBrush}"
      Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- Entrada de la página: aparece y sube 16 px (0,35 s) -->
        <Storyboard x:Key="SbEntrada">
            <DoubleAnimation Storyboard.TargetName="raiz" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="raiz"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="16" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Lista horizontal de tarjetas -->
        <ItemsPanelTemplate x:Key="PanelHorizontal">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ItemTarjeta">
            <Button Style="{StaticResource TarjetaCoche}" Content="{Binding}"
                    AutomationProperties.Name="{Binding Nombre}" ToolTip="Ver detalles"/>
        </DataTemplate>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SbEntrada}"/>
        </EventTrigger>
    </Page.Triggers>

    <ScrollViewer x:Name="raiz" VerticalScrollBarVisibility="Auto" Focusable="False">
        <ScrollViewer.RenderTransform>
            <TranslateTransform Y="0"/>
        </ScrollViewer.RenderTransform>

        <StackPanel MaxWidth="1140" Margin="32,28,32,40">

            <!-- ===================== CAMPAÑAS (carrusel) ===================== -->
            <Grid x:Name="hero" Height="330" MouseEnter="Hero_MouseEnter" MouseLeave="Hero_MouseLeave">

                <!-- Campaña 1: lanzamiento Polestar 5 -->
                <Grid x:Name="campana0">
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#111317" Offset="0"/>
                                <GradientStop Color="#4A3A24" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Viewbox HorizontalAlignment="Right" Width="560" Margin="0,60,24,10">
                        <Canvas Width="300" Height="100">
                            <Path Data="{StaticResource SiluetaCarroceria}" Fill="#D4943A" Opacity="0.85"/>
                            <Path Data="{StaticResource SiluetaVentanas}" Fill="#55000000"/>
                            <Path Data="{StaticResource SiluetaRuedas}" Fill="#0B0C0E"/>
                        </Canvas>
                    </Viewbox>
                    <Image x:Name="imgCampana0" Stretch="UniformToFill"/>
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#CC000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="0.7"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="48,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="470">
                        <TextBlock Text="NUEVO · ENTREGAS EN ESPAÑA" Foreground="{StaticResource AcentoBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Polestar 5" Foreground="White" FontSize="46" FontWeight="Light" Margin="0,6,0,0"/>
                        <TextBlock Text="El gran turismo eléctrico de cuatro plazas ya está en nuestras tiendas."
                                   Foreground="#E6E7EA" FontSize="18" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                            <Button Content="Descubrir el Polestar 5" Style="{StaticResource BotonPrimario}"
                                    Tag="Polestar 5" Click="Campana_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Campaña 2: Black Friday -->
                <Grid x:Name="campana1" Opacity="0" Visibility="Hidden">
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0E0F12" Offset="0"/>
                                <GradientStop Color="#1F2D3D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Viewbox HorizontalAlignment="Right" Width="540" Margin="0,64,30,12">
                        <Canvas Width="300" Height="100">
                            <Path Data="{StaticResource SiluetaCarroceria}" Fill="#7FA3C4" Opacity="0.85"/>
                            <Path Data="{StaticResource SiluetaVentanas}" Fill="#55000000"/>
                            <Path Data="{StaticResource SiluetaRuedas}" Fill="#0B0C0E"/>
                        </Canvas>
                    </Viewbox>
                    <Image x:Name="imgCampana1" Stretch="UniformToFill"/>
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#CC000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="0.7"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="48,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="470">
                        <TextBlock Text="BLACK FRIDAY · HASTA EL 30 DE NOVIEMBRE" Foreground="{StaticResource AcentoBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Polestar 2 desde 42.900 €" Foreground="White" FontSize="40" FontWeight="Light"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="5.300 € de descuento directo en la berlina con más autonomía de la gama."
                                   Foreground="#E6E7EA" FontSize="18" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                            <Button Content="Ver la oferta" Style="{StaticResource BotonPrimario}"
                                    Tag="Polestar 2" Click="Campana_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Campaña 3: Polestar 4 SUV -->
                <Grid x:Name="campana2" Opacity="0" Visibility="Hidden">
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#15171B" Offset="0"/>
                                <GradientStop Color="#3C4A44" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Viewbox HorizontalAlignment="Right" Width="540" Margin="0,56,30,12">
                        <Canvas Width="300" Height="100">
                            <Path Data="{StaticResource SiluetaCarroceria}" Fill="#B9C7BE" Opacity="0.85"/>
                            <Path Data="{StaticResource SiluetaVentanas}" Fill="#55000000"/>
                            <Path Data="{StaticResource SiluetaRuedas}" Fill="#0B0C0E"/>
                        </Canvas>
                    </Viewbox>
                    <Image x:Name="imgCampana2" Stretch="UniformToFill"/>
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#CC000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="0.7"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="48,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="470">
                        <TextBlock Text="RECIÉN LLEGADO" Foreground="{StaticResource AcentoBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Polestar 4 SUV" Foreground="White" FontSize="46" FontWeight="Light" Margin="0,6,0,0"/>
                        <TextBlock Text="Más altura y 530 litros de maletero. El mismo diseño escandinavo."
                                   Foreground="#E6E7EA" FontSize="18" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                            <Button Content="Conócelo" Style="{StaticResource BotonPrimario}"
                                    Tag="Polestar 4 SUV" Click="Campana_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Controles del carrusel: indicadores + pausa (accesibilidad) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="48,0,0,22">
                    <Button x:Name="punto0" Style="{StaticResource BotonPlano}" Tag="0" Click="Punto_Click"
                            Margin="0,0,8,0" AutomationProperties.Name="Campaña 1" ToolTip="Campaña 1">
                        <Border x:Name="marcaPunto0" Height="8" Width="26" CornerRadius="4" Background="{StaticResource AcentoBrush}"/>
                    </Button>
                    <Button x:Name="punto1" Style="{StaticResource BotonPlano}" Tag="1" Click="Punto_Click"
                            Margin="0,0,8,0" AutomationProperties.Name="Campaña 2" ToolTip="Campaña 2">
                        <Border x:Name="marcaPunto1" Height="8" Width="8" CornerRadius="4" Background="#80FFFFFF"/>
                    </Button>
                    <Button x:Name="punto2" Style="{StaticResource BotonPlano}" Tag="2" Click="Punto_Click"
                            Margin="0,0,18,0" AutomationProperties.Name="Campaña 3" ToolTip="Campaña 3">
                        <Border x:Name="marcaPunto2" Height="8" Width="8" CornerRadius="4" Background="#80FFFFFF"/>
                    </Button>
                    <Button x:Name="btnPausa" Style="{StaticResource BotonPlano}" Click="Pausa_Click"
                            ToolTip="Pausar el cambio automático" AutomationProperties.Name="Pausar carrusel">
                        <TextBlock x:Name="iconoPausa" Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== NOVEDADES ===================== -->
            <Grid Margin="0,44,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,8,32,0">
                    <TextBlock Text="Novedades" Style="{StaticResource TituloSeccion}"/>
                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0,8,0,16"
                               Text="Los últimos modelos en llegar a España. Pulsa sobre una tarjeta para ver su ficha completa."/>
                    <Button Content="Ver todos los modelos  →" Style="{StaticResource BotonEnlace}"
                            HorizontalAlignment="Left" Click="VerModelos_Click"/>
                </StackPanel>
                <ItemsControl x:Name="listaNovedades" Grid.Column="1" Focusable="False"
                              ItemsPanel="{StaticResource PanelHorizontal}"
                              ItemTemplate="{StaticResource ItemTarjeta}"
                              Button.Click="Tarjeta_Click"/>
            </Grid>

            <!-- ===================== MEJOR PRECIO ===================== -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,8,32,0">
                    <TextBlock Text="Mejor precio" Style="{StaticResource TituloSeccion}"/>
                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0,8,0,0"
                               Text="Los modelos más accesibles de la gama, con las ofertas vigentes ya aplicadas."/>
                </StackPanel>
                <ItemsControl x:Name="listaMejorPrecio" Grid.Column="1" Focusable="False"
                              ItemsPanel="{StaticResource PanelHorizontal}"
                              ItemTemplate="{StaticResource ItemTarjeta}"
                              Button.Click="Tarjeta_Click"/>
            </Grid>

            <!-- ===================== OFERTA DE TEMPORADA + CALCULADORA ===================== -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Oferta estacional -->
                <Border Grid.Column="0" CornerRadius="6" Padding="32">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B1D22" Offset="0"/>
                            <GradientStop Color="#2B2418" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="OFERTA DE NAVIDAD" Foreground="{StaticResource AcentoBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Tu cargador de casa, de regalo" Foreground="White" FontSize="26"
                                   FontWeight="Light" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Foreground="#D5D7DC" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Reserva cualquier Polestar antes del 31 de diciembre y te regalamos el cargador doméstico con la instalación incluida."/>
                        <Button Content="Ver modelos" Style="{StaticResource BotonSecundarioClaro}"
                                HorizontalAlignment="Left" Margin="0,22,0,0" Click="VerModelos_Click"/>
                    </StackPanel>
                </Border>

                <!-- Funcionalidad añadida: calculadora de ahorro -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="32">
                    <StackPanel>
                        <TextBlock Text="¿Cuánto ahorrarías?" Style="{StaticResource TituloSeccion}" FontSize="22"/>
                        <TextBlock Style="{StaticResource TextoSuave}" Margin="0,6,0,18"
                                   Text="Mueve el control para indicar los kilómetros que haces al año."/>
                        <Grid>
                            <TextBlock Text="Kilómetros al año" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="txtKm" Text="15.000 km" HorizontalAlignment="Right" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextoBrush}"/>
                        </Grid>
                        <Slider x:Name="sldKm" Minimum="5000" Maximum="40000" Value="15000"
                                SmallChange="1000" LargeChange="5000" TickFrequency="1000" IsSnapToTickEnabled="True"
                                ValueChanged="SldKm_ValueChanged" AutomationProperties.Name="Kilómetros al año"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock x:Name="txtAhorro" Text="1.001 €" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{StaticResource ExitoBrush}"/>
                            <TextBlock Text=" al año frente a un coche de gasolina" FontSize="14" Margin="6,0,0,7"
                                       VerticalAlignment="Bottom" Foreground="{StaticResource TextoSuaveBrush}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource TextoSuave}" FontSize="12" Margin="0,10,0,0"
                                   Text="Estimación: gasolina 6,5 L/100 km a 1,55 €/L; eléctrico 17 kWh/100 km a 0,20 €/kWh cargando en casa."/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
