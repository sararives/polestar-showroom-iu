<Page x:Class="PolestarShowroom.Paginas.GaleriaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="760"
      Title="Modelos" FontFamily="{StaticResource Fuente}" Background="{StaticResource FondoBrush}"
      Loaded="Page_Loaded" PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>
        <Storyboard x:Key="SbEntrada">
            <DoubleAnimation Storyboard.TargetName="raiz" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="raiz"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="16" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Ficha de detalle: entra deslizándose desde la derecha -->
        <Storyboard x:Key="SbAbrirDetalle">
            <DoubleAnimation Storyboard.TargetName="fondoDetalle" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="panelDetalle"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="460" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="SbCerrarDetalle" Completed="SbCerrarDetalle_Completed">
            <DoubleAnimation Storyboard.TargetName="fondoDetalle" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="panelDetalle"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="460" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="TituloFiltro" TargetType="TextBlock" BasedOn="{StaticResource Etiqueta}">
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SbEntrada}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid x:Name="raiz">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== FILTROS ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SuperficieBrush}" BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="32,28,28,28">
                    <TextBlock Text="Filtrar" Style="{StaticResource TituloSeccion}" FontSize="20"/>

                    <TextBlock Text="Carrocería" Style="{StaticResource TituloFiltro}"/>
                    <RadioButton x:Name="rbTodos" Content="Todas" GroupName="tipo" IsChecked="True" Checked="Filtro_Cambiado"/>
                    <RadioButton Content="Berlina" Tag="Berlina" GroupName="tipo" Checked="Filtro_Cambiado"/>
                    <RadioButton Content="SUV" Tag="SUV" GroupName="tipo" Checked="Filtro_Cambiado"/>
                    <RadioButton Content="Coupé" Tag="Coupé" GroupName="tipo" Checked="Filtro_Cambiado"/>
                    <RadioButton Content="Gran Turismo" Tag="Gran Turismo" GroupName="tipo" Checked="Filtro_Cambiado"/>

                    <Grid Margin="0,22,0,10">
                        <TextBlock Text="Precio máximo" Style="{StaticResource Etiqueta}" Margin="0"/>
                        <TextBlock x:Name="txtPrecioMax" Text="Sin límite" HorizontalAlignment="Right" FontSize="13"
                                   Foreground="{StaticResource TextoSuaveBrush}"/>
                    </Grid>
                    <Slider x:Name="sldPrecio" Minimum="40000" Maximum="150000" Value="150000"
                            TickFrequency="5000" IsSnapToTickEnabled="True" SmallChange="5000" LargeChange="10000"
                            ValueChanged="Precio_Cambiado" AutomationProperties.Name="Precio máximo"/>

                    <TextBlock Text="Promociones" Style="{StaticResource TituloFiltro}"/>
                    <CheckBox x:Name="chkOfertas" Content="Solo modelos en oferta" FontSize="14"
                              Foreground="{StaticResource TextoBrush}" Checked="Filtro_Cambiado" Unchecked="Filtro_Cambiado"/>

                    <Button Content="Restablecer filtros" Style="{StaticResource BotonSecundario}" Padding="16,9"
                            FontSize="14" Margin="0,30,0,0" Click="Restablecer_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== RESULTADOS ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior: título, contador, búsqueda y orden -->
            <Grid Margin="36,28,36,18">
                <StackPanel>
                    <TextBlock Text="Todos los modelos" Style="{StaticResource TituloSeccion}"/>
                    <TextBlock x:Name="txtContador" Text="8 modelos" Style="{StaticResource TextoSuave}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="230">
                        <TextBox x:Name="txtBuscar" Style="{StaticResource CampoTexto}" Padding="36,8,10,8" FontSize="14"
                                 TextChanged="Buscar_Cambiado" AutomationProperties.Name="Buscar modelo"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="13,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextoSuaveBrush}" IsHitTestVisible="False"/>
                        <TextBlock x:Name="placeholderBuscar" Text="Buscar modelo…" FontSize="14" Margin="38,0,0,0"
                                   VerticalAlignment="Center" Foreground="#9A9EA6" IsHitTestVisible="False"/>
                    </Grid>
                    <ComboBox x:Name="cmbOrden" Width="200" Margin="12,0,0,0" FontSize="14" Padding="10,8"
                              VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="Orden_Cambiado"
                              AutomationProperties.Name="Ordenar por">
                        <ComboBoxItem Content="Precio: de menor a mayor"/>
                        <ComboBoxItem Content="Precio: de mayor a menor"/>
                        <ComboBoxItem Content="Mayor autonomía"/>
                        <ComboBoxItem Content="Mayor potencia"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid Margin="36,4,16,28">
                    <ItemsControl x:Name="listaCoches" Focusable="False" Button.Click="Tarjeta_Click">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TarjetaCoche}" Content="{Binding}"
                                        AutomationProperties.Name="{Binding Nombre}" ToolTip="Ver ficha completa"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado vacío: explica qué pasa y ofrece una salida -->
                    <StackPanel x:Name="panelVacio" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,60,0,0">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BordeBrush}"/>
                        <TextBlock Text="Ningún modelo coincide con tus filtros" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,14,0,6" HorizontalAlignment="Center" Foreground="{StaticResource TextoBrush}"/>
                        <TextBlock Text="Prueba a subir el precio máximo o a quitar algún filtro." Style="{StaticResource TextoSuave}"
                                   HorizontalAlignment="Center"/>
                        <Button Content="Restablecer filtros" Style="{StaticResource BotonPrimario}" HorizontalAlignment="Center"
                                Margin="0,18,0,0" Click="Restablecer_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ===================== FICHA DE DETALLE (capa superpuesta) ===================== -->
        <Grid x:Name="capaDetalle" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border x:Name="fondoDetalle" Background="#99000000" MouseLeftButtonDown="FondoDetalle_Click" Opacity="0"/>
            <Border x:Name="panelDetalle" Width="460" HorizontalAlignment="Right" Background="{StaticResource SuperficieBrush}">
                <Border.RenderTransform>
                    <TranslateTransform X="460"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Grid Height="230">
                                <Border Background="{Binding FondoTarjeta}"/>
                                <Viewbox Margin="40,50,40,24">
                                    <Canvas Width="300" Height="100">
                                        <Path Data="{StaticResource SiluetaCarroceria}" Fill="#F2FFFFFF"/>
                                        <Path Data="{StaticResource SiluetaVentanas}" Fill="#55000000"/>
                                        <Path Data="{StaticResource SiluetaRuedas}" Fill="#22252B"/>
                                    </Canvas>
                                </Viewbox>
                                <Image Source="{Binding Imagen}" Stretch="UniformToFill"/>
                                <Button x:Name="btnCerrarX" Style="{StaticResource BotonPlano}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,14,14,0" Click="CerrarDetalle_Click"
                                        ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar ficha">
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#CCFFFFFF">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextoBrush}"/>
                                    </Border>
                                </Button>
                            </Grid>

                            <StackPanel Margin="32,24,32,16">
                                <TextBlock Text="{Binding Tipo}" Foreground="{StaticResource AcentoTextoBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Nombre}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextoBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding PrecioTexto}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextoBrush}"/>
                                    <TextBlock Text="{Binding PrecioAnteriorTexto}" FontSize="15" Margin="10,0,0,3" VerticalAlignment="Bottom"
                                               TextDecorations="Strikethrough" Foreground="{StaticResource TextoSuaveBrush}"
                                               Visibility="{Binding DescuentoVisibilidad}"/>
                                </StackPanel>

                                <!-- Datos técnicos -->
                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                        <TextBlock Text="Autonomía (WLTP)" Style="{StaticResource TextoSuave}" FontSize="12"/>
                                        <TextBlock Text="{Binding AutonomiaTexto}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextoBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                        <TextBlock Text="Potencia" Style="{StaticResource TextoSuave}" FontSize="12"/>
                                        <TextBlock Text="{Binding PotenciaTexto}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextoBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="0 – 100 km/h" Style="{StaticResource TextoSuave}" FontSize="12"/>
                                        <TextBlock Text="{Binding AceleracionTexto}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextoBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Tracción" Style="{StaticResource TextoSuave}" FontSize="12"/>
                                        <TextBlock Text="{Binding Traccion}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextoBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Descripcion}" Style="{StaticResource TextoSuave}" FontSize="15"
                                           Margin="0,22,0,0" LineHeight="22"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Acciones siempre visibles abajo -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0" Padding="32,18">
                        <StackPanel>
                            <Button x:Name="btnPrueba" Content="Solicitar prueba de conducción" Style="{StaticResource BotonPrimario}"
                                    Click="SolicitarPrueba_Click"/>
                            <TextBlock Text="Precio orientativo con IVA. Consulta las condiciones en tu tienda."
                                       Style="{StaticResource TextoSuave}" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
