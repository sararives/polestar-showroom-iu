<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         PALETA DE COLORES
         Cambiando ColorAcento cambia el color de toda la aplicación.
         ============================================================ -->
    <Color x:Key="ColorAcento">#C9B18A</Color> <!-- Champán: elegido por Sara (antes dorado #D4943A) -->

    <SolidColorBrush x:Key="AcentoBrush" Color="{StaticResource ColorAcento}"/>
    <SolidColorBrush x:Key="AcentoTextoBrush" Color="#6E5A38"/> <!-- versión oscura del champán para texto sobre fondo claro -->
    <SolidColorBrush x:Key="FondoBrush" Color="#F4F2EE"/>
    <SolidColorBrush x:Key="SuperficieBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OscuroBrush" Color="#111317"/>
    <SolidColorBrush x:Key="OscuroSuaveBrush" Color="#1C1F25"/>
    <SolidColorBrush x:Key="TextoBrush" Color="#16181D"/>
    <SolidColorBrush x:Key="TextoSuaveBrush" Color="#5C616B"/>
    <SolidColorBrush x:Key="TextoClaroBrush" Color="#C9CCD3"/>
    <SolidColorBrush x:Key="BordeBrush" Color="#D9D5CE"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="ErrorFondoBrush" Color="#FDECEA"/>
    <SolidColorBrush x:Key="ExitoBrush" Color="#2E7D4F"/>

    <FontFamily x:Key="Fuente">Segoe UI</FontFamily>

    <!-- ============================================================
         FORMAS VECTORIALES (no dependen de imágenes externas)
         ============================================================ -->
    <!-- Estrella de 4 puntas usada como símbolo junto al nombre -->
    <Geometry x:Key="FormaEstrella">M12,0 L14.2,9.8 L24,12 L14.2,14.2 L12,24 L9.8,14.2 L0,12 L9.8,9.8 Z</Geometry>

    <!-- Silueta genérica de coche (lienzo de 300 x 100) -->
    <Geometry x:Key="SiluetaCarroceria">M10,70 L20,54 Q30,47 60,44 L98,40 Q122,22 150,18 L200,18 Q226,20 246,38 L276,44 Q292,48 292,60 L292,72 Q292,76 288,76 L262,76 A22,22 0 0 0 218,76 L92,76 A22,22 0 0 0 48,76 L14,76 Q10,76 10,70 Z</Geometry>
    <Geometry x:Key="SiluetaVentanas">M108,42 Q128,27 152,24 L171,24 L171,42 Z M177,24 L198,24 Q220,26 236,41 L177,42 Z</Geometry>
    <Geometry x:Key="SiluetaRuedas">M52,76 A18,18 0 1 1 88,76 A18,18 0 1 1 52,76 Z M222,76 A18,18 0 1 1 258,76 A18,18 0 1 1 222,76 Z</Geometry>

    <!-- ============================================================
         TEXTOS
         ============================================================ -->
    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
    </Style>

    <Style x:Key="TextoSuave" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuaveBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ============================================================
         BOTONES
         Todos tienen: cambio al pasar el ratón, al pulsar, al estar
         deshabilitados y un marco visible al llegar con el teclado (Tab).
         ============================================================ -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AcentoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="22,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="foco" Margin="-4" CornerRadius="7" BorderThickness="2"
                                BorderBrush="{StaticResource AcentoBrush}" Visibility="Hidden"/>
                        <Border x:Name="fondo" CornerRadius="4" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="brillo" CornerRadius="4" Background="White" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="brillo" Property="Opacity" Value="0.18"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="brillo" Property="Background" Value="Black"/>
                            <Setter TargetName="brillo" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextoBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
    </Style>

    <Style x:Key="BotonSecundarioClaro" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Botón con aspecto de enlace de texto -->
    <Style x:Key="BotonEnlace" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AcentoTextoBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="foco" Background="Transparent" BorderThickness="0,0,0,1.5"
                            BorderBrush="Transparent" Padding="0,2">
                        <ContentPresenter RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="foco" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="foco" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón del menú de navegación. Tag="activo" marca la sección actual. -->
    <Style x:Key="BotonNav" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextoClaroBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Height" Value="72"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Center" RecognizesAccessKey="True"/>
                        <Border x:Name="linea" Height="3" VerticalAlignment="Bottom" Margin="14,0"
                                Background="{StaticResource AcentoBrush}" Visibility="Hidden"/>
                        <Border x:Name="foco" Margin="4,16" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{StaticResource AcentoBrush}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="activo">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="linea" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón transparente (logotipo, puntos del carrusel...) -->
    <Style x:Key="BotonPlano" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter/>
                        <Border x:Name="foco" Margin="-4" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{StaticResource AcentoBrush}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         CAMPOS DE TEXTO Y CONTRASEÑA
         Tag="error" pinta el borde en rojo (gestión de errores).
         ============================================================ -->
    <Style x:Key="CampoTexto" TargetType="TextBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="borde" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="#A9A39A"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="error">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CampoPassword" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="borde" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="#A9A39A"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="error">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         TARJETA DE COCHE (se usa en Inicio y en Galería)
         Si existe la foto en la carpeta Imagenes se muestra la foto;
         si no, se ve una silueta vectorial sobre un degradado.
         ============================================================ -->
    <DataTemplate x:Key="PlantillaCoche">
        <StackPanel Width="250">
            <Grid Height="140">
                <Border CornerRadius="6,6,0,0" Background="{Binding FondoTarjeta}"/>
                <Viewbox Margin="26,30,26,14">
                    <Canvas Width="300" Height="100">
                        <Path Data="{StaticResource SiluetaCarroceria}" Fill="#F2FFFFFF"/>
                        <Path Data="{StaticResource SiluetaVentanas}" Fill="#55000000"/>
                        <Path Data="{StaticResource SiluetaRuedas}" Fill="#22252B"/>
                    </Canvas>
                </Viewbox>
                <Image Source="{Binding Imagen}" Stretch="UniformToFill"/>
                <Border Background="{StaticResource AcentoBrush}" CornerRadius="3" Margin="12"
                        Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding EtiquetaVisibilidad}">
                    <TextBlock Text="{Binding Etiqueta}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoBrush}"/>
                </Border>
            </Grid>
            <StackPanel Margin="16,12,16,16">
                <TextBlock Text="{Binding Nombre}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextoBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Tipo}" FontSize="13" Foreground="{StaticResource TextoSuaveBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{Binding PrecioTexto}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextoBrush}"/>
                    <TextBlock Text="{Binding PrecioAnteriorTexto}" FontSize="13" Margin="8,0,0,0"
                               VerticalAlignment="Bottom" TextDecorations="Strikethrough"
                               Foreground="{StaticResource TextoSuaveBrush}"
                               Visibility="{Binding DescuentoVisibilidad}"/>
                </StackPanel>
                <TextBlock Text="{Binding Resumen}" FontSize="13" Margin="0,4,0,0"
                           Foreground="{StaticResource TextoSuaveBrush}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="TarjetaCoche" TargetType="Button">
        <Setter Property="ContentTemplate" Value="{StaticResource PlantillaCoche}"/>
        <Setter Property="Margin" Value="0,0,20,20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="tarjeta" Background="White" CornerRadius="6" BorderThickness="1.5"
                            BorderBrush="{StaticResource BordeBrush}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.08"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Animación sutil: la tarjeta crece un 3 % al pasar el ratón -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tarjeta"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.03" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="tarjeta"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.03" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tarjeta"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="tarjeta"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="tarjeta" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="tarjeta" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Contenedor blanco con sombra suave para agrupar bloques -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

</ResourceDictionary>
