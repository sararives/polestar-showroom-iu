<Window x:Class="PolestarShowroom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Polestar · Showroom España"
        Width="1280" Height="800" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoBrush}"
        FontFamily="{StaticResource Fuente}">

    <Window.Resources>
        <!-- Aviso flotante (toast): aparece, se queda 2,5 s y desaparece -->
        <Storyboard x:Key="SbAviso">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="aviso" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.75" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3.1" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="aviso"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="-12"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>   <!-- Cabecera: logotipo + menú (común) -->
            <RowDefinition Height="*"/>    <!-- Contenido: aquí se cargan las páginas -->
            <RowDefinition Height="Auto"/> <!-- Pie de página (común) -->
        </Grid.RowDefinitions>

        <!-- ===================== CABECERA ===================== -->
        <Border Grid.Row="0" Background="{StaticResource OscuroBrush}">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logotipo: siempre vuelve al inicio (convención web) -->
                <Button x:Name="btnLogo" Grid.Column="0" Style="{StaticResource BotonPlano}"
                        Click="Logo_Click" ToolTip="Volver al inicio" TabIndex="0"
                        AutomationProperties.Name="Polestar, volver al inicio" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FormaEstrella}" Fill="{StaticResource AcentoBrush}"
                              Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="P O L E S T A R" Foreground="White" FontSize="19" FontWeight="Light"/>
                            <!-- Eslogan elegido por Sara -->
                            <TextBlock Text="El futuro ya se conduce" Foreground="{StaticResource AcentoBrush}"
                                       FontSize="11" Margin="1,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Menú de navegación -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="navInicio" Content="Inicio" Style="{StaticResource BotonNav}"
                            Click="NavInicio_Click" TabIndex="1" ToolTip="Novedades y ofertas"/>
                    <Button x:Name="navGaleria" Content="Modelos" Style="{StaticResource BotonNav}"
                            Click="NavGaleria_Click" TabIndex="2" ToolTip="Galería con todos los modelos"/>
                </StackPanel>

                <!-- Zona de usuario -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtSaludo" Foreground="{StaticResource TextoClaroBrush}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
                    <Button x:Name="navLogin" Content="Iniciar sesión" Style="{StaticResource BotonSecundarioClaro}"
                            Padding="18,8" FontSize="14" Click="NavLogin_Click" TabIndex="3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== CONTENIDO ===================== -->
        <Frame x:Name="marco" Grid.Row="1" NavigationUIVisibility="Hidden" Focusable="False"/>

        <!-- Aviso flotante -->
        <Border x:Name="aviso" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,18,0,0" Padding="20,12" CornerRadius="6" Background="{StaticResource OscuroSuaveBrush}"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource FormaEstrella}" Fill="{StaticResource AcentoBrush}"
                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtAviso" Foreground="White" FontSize="14" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ===================== PIE DE PÁGINA ===================== -->
        <Border Grid.Row="2" Background="{StaticResource OscuroSuaveBrush}" Padding="32,12">
            <Grid>
                <TextBlock Foreground="#8E929B" FontSize="12" VerticalAlignment="Center"
                           Text="© 2026 Polestar España · Prototipo académico — Interfaces de Usuario (UMH). Datos y precios orientativos."/>
                <TextBlock Foreground="#8E929B" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="Atención al cliente · Lun–Vie 9:00–19:00"/>
            </Grid>
        </Border>
    </Grid>
</Window>
